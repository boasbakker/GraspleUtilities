{
  "manifest_version": 2,
  "name": "Exercise LaTeX+Text -> Clipboard (Firefox)",
  "version": "1.1",
  "description": "Extract text + LaTeX from .exercise-wrapper and copy to clipboard (MV2 for Firefox)",
  "permissions": [
    "activeTab",
    "tabs",
    "clipboardWrite",
    "storage",
    "https://app.grasple.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.grasple.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Copy exercise text and LaTeX",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/icon48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "temp@example.com"
    }
}
}
